# ==============================================================================
# VARUNETRA: Production Environment Variables & Deployment Configuration
# Problem Statement SIH26085: Urban Flood Nowcasting System (Drainage and Rainfall Coupling)
# Ministry of Earth Sciences (MoES)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Server & Network Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
WORKERS=1
LOG_LEVEL=info
DATA_MODE=DEMO

# CORS Origins (Comma-separated or JSON list of permitted origins in production)
# BACKEND_CORS_ORIGINS=["https://varunetra.gov.in", "https://command.varunetra.gov.in"]

# ------------------------------------------------------------------------------
# 2. Terrain Intelligence & Copernicus GLO-30 DSM Storage Paths
# ------------------------------------------------------------------------------
# In container environments, mounted at /app/data/dem/copernicus/pilot
COPERNICUS_PILOT_DIR=./data/dem/copernicus/pilot
COPERNICUS_RAW_DIR=./data/dem/copernicus/raw

# ------------------------------------------------------------------------------
# 3. Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
# When deployed behind the provided Nginx reverse-proxy (frontend at /, backend at /api),
# these can remain empty or commented out, and the client will use relative routing.
# If hosting frontend and backend on separate servers/domains, uncomment and configure:
# VITE_API_BASE_URL=https://api.varunetra.gov.in/api
# VITE_WS_URL=wss://api.varunetra.gov.in/api/ws

# ------------------------------------------------------------------------------
# 4. Multi-Source Live Telemetry Provider Credentials (Optional / Future Live)
# ------------------------------------------------------------------------------
# If left blank, VARUNETRA gracefully reports provider status as 'NOT CONFIGURED'
# and executes using verified local synthetic/Copernicus pilot datasets.
# IMD_API_KEY=
# DWR_RADAR_HOST=
# MOSDAC_API_KEY=
# CWC_TELEMETRY_URL=
