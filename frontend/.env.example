# VARUNETRA Frontend Production Environment Configuration
#
# Default behavior (empty or omitted):
# - In local Vite dev (localhost:5173): routes to http://localhost:8000/api and ws://localhost:8000/api/ws
# - In production behind reverse-proxy (e.g. Nginx at /): routes to relative /api and /api/ws
#
# Custom backend URL (e.g. when frontend and backend are on separate domains/hosts):
# VITE_API_BASE_URL=https://api.varunetra.gov.in/api
# VITE_WS_URL=wss://api.varunetra.gov.in/api/ws
