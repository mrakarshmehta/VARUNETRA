# ==============================================================================
# VARUNETRA / FloodSense — Production Environment Configuration Template
# Problem Statement SIH26085: Urban Flood Nowcasting System
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' on the production target host:
#    cp .env.production.example .env
# 2. Populate all REQUIRED and REAL MODE ONLY variables with high-entropy values.
# 3. Restrict permissions: chmod 600 .env
# 4. Never commit the populated .env file to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SYSTEM PROVENANCE & OPERATIONAL MODE
# ------------------------------------------------------------------------------
# [REQUIRED]
# Options: 'REAL' (authoritative production), 'DEMO' (benchmarking & exercises)
# In 'REAL' mode:
# - Fails closed to UNAVAILABLE if authoritative Copernicus GLO-30 DSM is missing
# - Synthetic benchmark fallback is strictly blocked
# - Demo auto-login (/api/auth/demo-login) is disabled (returns 403 Forbidden)
DATA_MODE=REAL

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & CRYPTOGRAPHY
# ------------------------------------------------------------------------------
# [REQUIRED in REAL MODE]
# Minimum 32-character high-entropy cryptographic secret for HMAC-SHA256 JWT tokens.
# Backend fails startup if missing or matching insecure patterns ('dev', 'secret', etc.).
# Generate via: openssl rand -hex 32
AUTH_SECRET_KEY=PLACEHOLDER_GENERATE_WITH_OPENSSL_RAND_HEX_32_MIN_32_CHARS

# [OPTIONAL] Token lifetime in minutes (Default: 1440 = 24 hours)
AUTH_TOKEN_EXPIRE_MINUTES=1440

# [REQUIRED in REAL MODE]
# Initial password for the bootstrap 'admin' account.
# Must be at least 12 characters. Insecure passwords ('admin', 'password', 'varunetra')
# are rejected at startup. Once initialized, restarting the application will NOT
# overwrite the established administrator credentials.
ADMIN_DEFAULT_PASSWORD=PLACEHOLDER_SPECIFY_STRONG_BOOTSTRAP_PASSWORD_MIN_12_CHARS

# ------------------------------------------------------------------------------
# 3. NETWORK SECURITY & CORS ORIGINS
# ------------------------------------------------------------------------------
# [REQUIRED in REAL MODE]
# JSON array of explicitly allowed origin URLs.
# Wildcard '*' is strictly prohibited in REAL mode and causes immediate startup failure.
# Example: ["https://varunetra.gov.in", "https://flood.patnamunicipal.org"]
BACKEND_CORS_ORIGINS=["https://YOUR_OFFICIAL_DOMAIN_HERE.gov.in"]

# ------------------------------------------------------------------------------
# 4. SERVER RUNTIME & WORKER CONCURRENCY
# ------------------------------------------------------------------------------
# [REQUIRED]
# Process binding host. '0.0.0.0' binds all interfaces inside the container.
HOST=0.0.0.0

# [REQUIRED]
# Ingress port for FastAPI Uvicorn service.
PORT=8000

# [REQUIRED]
# Concurrency workers. VARUNETRA mandates WORKERS=1 while WebSocket client pools,
# in-memory nowcast loops, and disaster scenario state are process-local.
# Configuring WORKERS > 1 triggers an immediate critical startup exception.
WORKERS=1

# [OPTIONAL] Logging severity (Default: 'info'; Options: 'debug', 'info', 'warning', 'error')
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 5. PERSISTENT STORAGE
# ------------------------------------------------------------------------------
# [OPTIONAL] SQLite database path (Default: 'data/db/varunetra_operations.db')
# Must reside on a mounted persistent volume in Docker deployments.
OPERATIONS_DB_PATH=data/db/varunetra_operations.db

# ------------------------------------------------------------------------------
# 6. AUTHORITATIVE COPERNICUS GLO-30 DSM DATA PATHS
# ------------------------------------------------------------------------------
# [REAL MODE ONLY]
# Directory containing preprocessed Patna pilot elevation raster (.npy and metadata.json).
# Default: ./data/dem/copernicus/pilot
COPERNICUS_PILOT_DIR=data/dem/copernicus/pilot

# [REAL MODE ONLY]
# Directory containing raw authoritative Copernicus GLO-30 DSM Cloud-Optimized GeoTIFFs.
# Mounted as read-only (:ro) inside container.
# Default: ./data/dem/copernicus/raw
COPERNICUS_RAW_DIR=data/dem/copernicus/raw
